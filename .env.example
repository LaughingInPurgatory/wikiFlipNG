# WikiFlip NG configuration — every value is optional.

# Admin account (defaults to "admin"). No default password exists: leave both
# password variables unset and the app generates one on first start and logs it.
WIKIFLIP_ADMIN_USER=admin
# WIKIFLIP_ADMIN_PASSWORD=at-least-5-characters
# Preferred — keeps the plaintext out of the environment:
#   npm run hash-password -- 'your password'
# WIKIFLIP_ADMIN_PASSWORD_HASH=scrypt$...

# Where the wiki lives. Back this file up; it is the whole site.
# WIKIFLIP_DB=./data/wiki.db

# HTTP port
# PORT=3000

# Max upload size in MB (images and PDFs)
# WIKIFLIP_MAX_UPLOAD_MB=30

# Set behind a reverse proxy so secure cookies and client IPs are correct
# (see https://expressjs.com/en/guide/behind-proxies.html)
# TRUST_PROXY=1

# Sessions survive restarts without this; set it to share one secret across
# replicas or to rotate all sessions on demand (16+ characters).
# WIKIFLIP_SESSION_SECRET=
